LEFT JOIN [db_EPPIIIP_New].[dbo].[TBL_M_USERMASTER] h
    ON (
            CASE 
                WHEN LEN(h.EM) > 10 THEN SUBSTRING(h.EM,1,10)
                ELSE h.EM
            END = m.CardSerialNo
       )
