Sub PasteToExcel() ' Dynamic Last Row - K. Evangelista 031326

    'Create Excel application
    Dim xlApp, xlBook, xlSheet, lastRow
    
    Set xlApp = CreateObject("Excel.Application")
    xlApp.Visible = True
    xlApp.DisplayAlerts = False
    xlApp.ScreenUpdating = False
    
    'Open workbook
    Set xlBook = xlApp.Workbooks.Open("D:\DownloadGNSTblAuth\TBL_AUTH\YourWorkbook.xlsx")
    Set xlSheet = xlBook.Sheets(1)
    
    'Paste clipboard to A1
    xlSheet.Range("A1").PasteSpecial
    
    'Delete first row
    xlSheet.Rows(1).Delete
    
    'Find last row dynamically
    lastRow = xlSheet.Cells(xlSheet.Rows.Count, "A").End(-4162).Row   'xlUp
    
    'Sort column A ascending
    xlSheet.Sort.SortFields.Clear
    xlSheet.Sort.SortFields.Add xlSheet.Range("A1:A" & lastRow), 0, 1
    With xlSheet.Sort
        .SetRange xlSheet.Range("A1:A" & lastRow)
        .Header = 2
        .Apply
    End With
    
    'Filter dashed line rows
    xlSheet.Range("A1:A" & lastRow).AutoFilter 1, "--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
    
    'Clear filtered cells
    xlSheet.Range("A1:A" & lastRow).SpecialCells(12).ClearContents
    
    'Remove filter
    xlSheet.AutoFilterMode = False
    
    'Sort column A descending
    xlSheet.Sort.SortFields.Clear
    xlSheet.Sort.SortFields.Add xlSheet.Range("A1:A" & lastRow), 0, 2
    With xlSheet.Sort
        .SetRange xlSheet.Range("A1:A" & lastRow)
        .Header = 2
        .Apply
    End With
    
    'Convert text to columns using |
    xlSheet.Columns("A").TextToColumns _
        xlSheet.Range("A1"), _
        1, _
        1, _
        False, _
        False, _
        False, _
        False, _
        False, _
        True, "|"
    
    'Delete column A
    xlSheet.Columns("A").Delete
    
    'Headers
    xlSheet.Range("A1").Value = "User Name"
    xlSheet.Range("B1").Value = "Complete name"
    xlSheet.Range("E1").Value = "Room Number"
    xlSheet.Range("F1").Value = "Valid through"
    
    'Save as CSV
    xlBook.SaveAs "\\172.16.52.232\tblauthority\export.csv", 62   '62 = xlCSVUTF8
    
    xlBook.Close
    
    'Cleanup
    xlApp.ScreenUpdating = True
    
    ' Close the Excel application
    xlApp.Quit
    
    Set xlSheet = Nothing
    Set xlBook = Nothing
    Set xlApp = Nothing

End Sub




