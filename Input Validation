✅ Improved Version (Best Practice)

Sub InputValidation()

    Dim ws As Worksheet
    Dim sumFilePath As String
    Dim highlightRange As Range

    Set ws = ThisWorkbook.Sheets(1)
    Set highlightRange = ws.Range("B5:L5")

    sumFilePath = Trim(ws.Range("B5").Value)

    ' Check if empty
    If sumFilePath = "" Then
        MsgBox "File path is required. Please enter a valid file path.", vbCritical
        highlightRange.Interior.Color = RGB(255, 199, 206)
        Exit Sub
    End If

    ' Check if folder or file exists
    If Dir(sumFilePath, vbDirectory) = "" Then
        MsgBox "The specified file path does not exist. Please check and try again.", vbCritical
        highlightRange.Interior.Color = RGB(255, 199, 206)
        Exit Sub
    End If

    ' Valid input
    highlightRange.Interior.Color = RGB(242, 242, 242)

End Sub


