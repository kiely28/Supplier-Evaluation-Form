Function ValidateFilePath(ws As Worksheet, pathCell As Range) As Boolean

    Dim filePath As String
    filePath = Trim(pathCell.Value)

    If filePath = "" Then
        MsgBox "File path is required.", vbCritical
        pathCell.Resize(1, 11).Interior.Color = RGB(255, 199, 206)
        ValidateFilePath = False
        Exit Function
    End If

    If Dir(filePath, vbDirectory) = "" Then
        MsgBox "The specified file path does not exist.", vbCritical
        pathCell.Resize(1, 11).Interior.Color = RGB(255, 199, 206)
        ValidateFilePath = False
        Exit Function
    End If

    pathCell.Resize(1, 11).Interior.Color = RGB(242, 242, 242)
    ValidateFilePath = True

End Function

