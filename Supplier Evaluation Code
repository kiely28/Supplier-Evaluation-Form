
Option Explicit

Sub UpdateSupplierEvaluationSummary()

    Dim evalFolder As String, evalfile As String
    Dim evalWB As Workbook
    Dim summaryWB As Workbook, summaryWS As Worksheet
    Dim cfgWS As Worksheet
    Dim findCell As Range

    Dim supplierCode As String
    Dim materialType As String
    Dim lastCfgRow As Long
    Dim r As Long

    Dim srcWS As Worksheet
    Dim srcSheetName As String

    Dim destRow As Long
    Dim hasMismatch As Boolean
    
    Dim completedFolder As String
    Dim invalidFolder As String
    Dim archiveFolder As String

    ' ===== PATHS =====
    evalfile = Trim(ThisWorkbook.Sheets("Sheet1").Range("B5").Value)
    evalFolder = Trim(ThisWorkbook.Sheets("Sheet1").Range("B8").Value) ' "D:\Supplier Evaluation Form\"
    completedFolder = evalFolder & "Completed\"
    invalidFolder = evalFolder & "Invalid\"
    archiveFolder = evalFolder & "Archive\"
    
    ' ===== CREATE FOLDERS IF NOT EXIST =====
    If Dir(completedFolder, vbDirectory) = "" Then MkDir completedFolder
    If Dir(invalidFolder, vbDirectory) = "" Then MkDir invalidFolder
    If Dir(archiveFolder, vbDirectory) = "" Then MkDir archiveFolder

    Set summaryWB = Workbooks.Open(evalfile)
    Set summaryWS = summaryWB.Sheets(2)
    Set cfgWS = ThisWorkbook.Sheets("Config_Mapping")

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    Dim fso As Object
    Dim folder As Object
    Dim file As Object
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set folder = fso.GetFolder(evalFolder)
    
    For Each file In folder.Files
    
        ' Only Excel files
        If LCase(fso.GetExtensionName(file.Name)) Like "xls*" Then
    
            'Dim evalFile As String
            evalfile = file.Name

        supplierCode = Trim(Left(evalfile, 6))

        Set findCell = summaryWS.Range("N12:N" & _
            summaryWS.Cells(summaryWS.Rows.Count, "N").End(xlUp).Row) _
            .Find(supplierCode, LookIn:=xlValues, LookAt:=xlWhole)

        If Not findCell Is Nothing Then

            destRow = findCell.Row
            hasMismatch = False

            materialType = Trim(summaryWS.Cells(findCell.Row, "L").Value)

            Set evalWB = Workbooks.Open(evalFolder & evalfile, ReadOnly:=True)

            lastCfgRow = cfgWS.Cells(cfgWS.Rows.Count, "A").End(xlUp).Row

            ' ==============================
            ' LOOP CONFIG MAPPINGS
            ' ==============================
            For r = 2 To lastCfgRow

                If cfgWS.Cells(r, "A").Value = materialType Then

                    ' Skip mapping rows
                    If cfgWS.Cells(r, "C").Value = 0 Then GoTo NextMap

                    ' Get source sheet name
                    srcSheetName = cfgWS.Cells(r, "F").Value

                    On Error Resume Next
                    Set srcWS = evalWB.Sheets(srcSheetName)
                    On Error GoTo 0

                    If srcWS Is Nothing Then GoTo NextMap

                        Dim cfgCategory As String
                        Dim srcCategory As String
                        Dim srcRow As Long
                        Dim destCell As Range

                        srcRow = cfgWS.Cells(r, "C").Value
                        Set destCell = summaryWS.Cells(findCell.Row, cfgWS.Cells(r, "E").Value)

                        ' Get category from config (e.g., M1)
                        cfgCategory = Trim(cfgWS.Cells(r, "B").Value)

                        ' Get category from source sheet Column B
                        srcCategory = ExtractCategory(srcWS.Cells(srcRow, "B").Value)

                        ' Copy value from merged C column
                        destCell.Value = GetMergedValue(srcWS.Range("C" & srcRow))

                        ' Validation Check
                        If UCase(cfgCategory) <> UCase(srcCategory) Then
                            destCell.Font.Color = RGB(255, 0, 0)
                            hasMismatch = True
                        Else
                            ' Reset formatting on success
                            destCell.Font.ColorIndex = xlAutomatic
                        End If
                End If
NextMap:
                Set srcWS = Nothing
            Next r

            If hasMismatch Then
                summaryWS.Cells(findCell.Row, "O").Interior.Color = RGB(255, 0, 0)
            Else
                summaryWS.Cells(findCell.Row, "O").Interior.Pattern = xlNone
            End If

            evalWB.Close SaveChanges:=False
            
            ' Archive old files first
            ArchiveExistingByPrefix completedFolder, archiveFolder, supplierCode
            file.Move completedFolder & evalfile

        ' =============================
        ' SUPPLIER NOT FOUND - INVALID
        ' =============================
        Else
            ' Archive old files first
            ArchiveExistingByPrefix invalidFolder, archiveFolder, supplierCode
            file.Move invalidFolder & evalfile
        End If
    End If

Next file

    'summaryWB.Save

    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Application.Calculation = xlCalculationAutomatic

    'MsgBox "Supplier Periodic Evaluation Summary updated successfully!", vbInformation
    
    Dim completedCount As Long
    Dim invalidCount As Long
    Dim totalSuppliers As Long
    
    completedCount = CountExcelFiles(completedFolder)
    invalidCount = CountExcelFiles(invalidFolder)
    
    totalSuppliers = CountSuppliersInSummary(summaryWS)
    
    ThisWorkbook.Sheets(1).Range("B13").Value = "Last updated: "
    ThisWorkbook.Sheets(1).Range("C13").Value = Format(Now, "mm/dd/yyyy hh:mm:ss AM/PM")
    
    ' Display results (adjust cells as needed)
    ThisWorkbook.Sheets(1).Range("B14").Value = "Completed:"
    ThisWorkbook.Sheets(1).Range("C14").Value = completedCount & "/" & totalSuppliers & " form(s)"
    
    ThisWorkbook.Sheets(1).Range("B15").Value = "Invalid:"
    ThisWorkbook.Sheets(1).Range("C15").Value = invalidCount & " form(s)"

End Sub

Function GetMergedValue(rng As Range) As Variant
    If rng.MergeCells Then
        GetMergedValue = rng.MergeArea.Cells(1, 1).Value2
    Else
        GetMergedValue = rng.Value2
    End If
End Function

Function ExtractCategory(val As String) As String
    Dim re As Object
    Dim m As Object

    Set re = CreateObject("VBScript.RegExp")
    re.Pattern = "^[A-Za-z]+[0-9]+"
    re.Global = False
    re.IgnoreCase = True

    If re.Test(Trim(val)) Then
        Set m = re.Execute(Trim(val))
        ExtractCategory = m(0)
    Else
        ExtractCategory = ""
    End If
End Function

Sub ArchiveExistingByPrefix(srcFolder As String, archiveFolder As String, prefix6 As String)
    Dim f As String
    Dim timeStamp As String

    timeStamp = Format(Now, "mmddyyyy_hhmmss")

    f = Dir(srcFolder & prefix6 & "*.xls*")

    Do While f <> ""
        Name srcFolder & f As archiveFolder & _
             Left(f, InStrRev(f, ".") - 1) & "_" & timeStamp & Mid(f, InStrRev(f, "."))
        f = Dir
    Loop
End Sub

Function CountExcelFiles(folderPath As String) As Long
    Dim fso As Object
    Dim f As Object
    Dim cnt As Long

    Set fso = CreateObject("Scripting.FileSystemObject")

    If fso.FolderExists(folderPath) = False Then
        CountExcelFiles = 0
        Exit Function
    End If

    For Each f In fso.GetFolder(folderPath).Files
        If LCase(fso.GetExtensionName(f.Name)) Like "xls*" Then
            cnt = cnt + 1
        End If
    Next f

    CountExcelFiles = cnt
End Function

Function CountSuppliersInSummary(ws As Worksheet) As Long
    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "N").End(xlUp).Row

    If lastRow < 13 Then
        CountSuppliersInSummary = 0
    Else
        CountSuppliersInSummary = WorksheetFunction.CountA(ws.Range("N13:N" & lastRow))
    End If
End Function

Sub ValidatePaths()

    Dim ws As Worksheet
    Dim filePath As String
    Dim folderPath As String
    Dim fileExt As String

    Set ws = ThisWorkbook.Sheets(1)

    filePath = Trim(ws.Range("B5").Value)
    folderPath = Trim(ws.Range("B8").Value)

    ' ===============================
    ' Validate Excel File Path (B5)
    ' ===============================
    If filePath = "" Then
        MsgBox "Excel file path (B5) is required.", vbCritical
        ws.Range("B5:L5").Interior.Color = RGB(255, 199, 206)
        Exit Sub
    End If

    fileExt = LCase(Mid(filePath, InStrRev(filePath, ".") + 1))

    If fileExt <> "xlsx" And fileExt <> "xls" Then
        MsgBox "The file in B5 must be an Excel file (.xlsx or .xls).", vbCritical
        ws.Range("B5:L5").Interior.Color = RGB(255, 199, 206)
        Exit Sub
    End If

    If Dir(filePath) = "" Then
        MsgBox "The Excel file path in B5 does not exist.", vbCritical
        ws.Range("B5:L5").Interior.Color = RGB(255, 199, 206)
        Exit Sub
    End If

    ws.Range("B5:L5").Interior.Color = RGB(242, 242, 242)

    ' ===============================
    ' Validate Folder Path (B8)
    ' ===============================
    If folderPath = "" Then
        MsgBox "Folder path (B8) is required.", vbCritical
        ws.Range("B8:L8").Interior.Color = RGB(255, 199, 206)
        Exit Sub
    End If

    If Dir(folderPath, vbDirectory) = "" Then
        MsgBox "The folder path in B8 does not exist.", vbCritical
        ws.Range("B8:L8").Interior.Color = RGB(255, 199, 206)
        Exit Sub
    End If

    ws.Range("B8:L8").Interior.Color = RGB(242, 242, 242)
    
    
    Dim startTime As Date
    Dim endTime As Date
    Dim duration As Double

    ' =========================
    ' START TIME
    ' =========================
    startTime = Now

    With ws
        .Range("H10").Value = "Start Date/Time:"
        .Range("I10").Value = DateValue(startTime)
        .Range("J10").Value = TimeValue(startTime)
        
        .Range("I10").NumberFormat = "mm/dd/yyyy"
        .Range("J10").NumberFormat = "hh:mm:ss AM/PM"
    End With

    On Error GoTo CleanExit

    UpdateSupplierEvaluationSummary
    
CleanExit:
    ' =========================
    ' END TIME
    ' =========================
    endTime = Now
    duration = endTime - startTime

    With ws
        .Range("H11").Value = "End Date/Time:"
        .Range("I11").Value = DateValue(endTime)
        .Range("J11").Value = TimeValue(endTime)
        .Range("I11").NumberFormat = "mm/dd/yyyy"
        .Range("J11").NumberFormat = "hh:mm:ss AM/PM"

        .Range("H12").Value = "Duration:"
        .Range("I12").Value = duration
        .Range("I12").NumberFormat = "[hh]:mm:ss"
    End With

    If Err.Number <> 0 Then
        MsgBox "Process ended with error: " & Err.Description, vbExclamation
    End If

    'MsgBox "Excel file and folder paths are valid.", vbInformation
    
    MsgBox "Supplier Periodic Evaluation Summary updated successfully!", vbInformation
End Sub
