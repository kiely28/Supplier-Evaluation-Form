  }

  // =========================================================
  // POPULATE MAIN INFORMATION
  // =========================================================

  sheet.getRange("F7").setValue(requestingSection);
  sheet.getRange("D8").setValue(requestDate);
  sheet.getRange("E9").setValue(reactivationDate);

  // =========================================================
  // CLEAR EXISTING USER DATA
  // =========================================================

  sheet.getRange("J1:K15").clear(ExcelScript.ClearApplyTo.contents);

  // =========================================================
  // LIMIT TO MAXIMUM 15 USERS
  // =========================================================

  const count = Math.min(
    Math.max(userIds.length, userNames.length),
    maxRows
  );

  // =========================================================
  // PREPARE USER ID DATA
  // =========================================================

  const idData: string[][] = [];

  for (let i = 0; i < count; i++) {

    if (i < userIds.length) {
      idData.push([String(userIds[i])]);
    } else {
      idData.push([""]);
    }
  }

  // =========================================================
  // PREPARE USER NAME DATA
  // =========================================================

  const nameData: string[][] = [];

  for (let i = 0; i < count; i++) {

    if (i < userNames.length) {
      nameData.push([String(userNames[i])]);
    } else {
      nameData.push([""]);
    }
