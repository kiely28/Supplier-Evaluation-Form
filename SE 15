Option Explicit

Sub GetDataFromSQLAndSave()

    '=========================================================
    ' SQL SERVER SETTINGS
    '=========================================================
    Dim ServerName As String
    Dim DatabaseName As String
    Dim SQLUser As String
    Dim SQLPassword As String
    
    ServerName = "YOUR_SERVER_NAME"
    DatabaseName = "YOUR_DATABASE_NAME"
    SQLUser = "YOUR_SQL_USERNAME"
    SQLPassword = "YOUR_SQL_PASSWORD"
    
    '=========================================================
    ' OUTPUT FILE
    '=========================================================
    Dim OutputPath As String
    
    OutputPath = ThisWorkbook.Path & "\TBLAUTH_Data.xlsx"
    
    '=========================================================
    ' OBJECTS
    '=========================================================
    Dim conn As Object
    Dim rs As Object
    Dim wb As Workbook
    Dim ws As Worksheet
    Dim tbl As ListObject
    
    Dim ConnectionString As String
    Dim i As Long
    Dim LastRow As Long
    Dim LastCol As Long
    
    On Error GoTo ErrorHandler
    
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    '=========================================================
    ' SQL CONNECTION
    '=========================================================
    ConnectionString = _
        "Provider=SQLOLEDB;" & _
        "Data Source=" & ServerName & ";" & _
        "Initial Catalog=" & DatabaseName & ";" & _
        "User ID=" & SQLUser & ";" & _
        "Password=" & SQLPassword & ";"
    
    Set conn = CreateObject("ADODB.Connection")
    Set rs = CreateObject("ADODB.Recordset")
    
    conn.Open ConnectionString
    
    '=========================================================
    ' EXECUTE STORED PROCEDURE
    '=========================================================
    rs.Open "EXEC TBLAUTH_GETDATA", conn, 0, 1
    
    '=========================================================
    ' CREATE NEW EXCEL FILE
    '=========================================================
    Set wb = Workbooks.Add
    Set ws = wb.Worksheets(1)
    
    ws.Name = "TBLAUTH_DATA"
    
    '=========================================================
    ' WRITE COLUMN HEADERS
    '=========================================================
    For i = 0 To rs.Fields.Count - 1
        ws.Cells(1, i + 1).Value = rs.Fields(i).Name
    Next i
    
    '=========================================================
    ' WRITE SQL DATA
    '=========================================================
    If Not rs.EOF Then
        ws.Range("A2").CopyFromRecordset rs
    End If
    
    '=========================================================
    ' FIND LAST ROW / COLUMN
    '=========================================================
    LastCol = rs.Fields.Count
    
    LastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    
    '=========================================================
    ' CREATE EXCEL TABLE
    '=========================================================
    If LastRow >= 2 Then
        
        Set tbl = ws.ListObjects.Add( _
                    SourceType:=xlSrcRange, _
                    Source:=ws.Range(ws.Cells(1, 1), _
                                     ws.Cells(LastRow, LastCol)), _
                    XlListObjectHasHeaders:=xlYes)
        
        tbl.Name = "TblTBLAUTHData"
        tbl.TableStyle = "TableStyleMedium2"
        
    End If
    
    '=========================================================
    ' FORMAT
    '=========================================================
    ws.Cells.EntireColumn.AutoFit
    
    '=========================================================
    ' SAVE AS XLSX
    '=========================================================
    wb.SaveAs Filename:=OutputPath, _
              FileFormat:=xlOpenXMLWorkbook
    
    wb.Close SaveChanges:=True
    
    '=========================================================
    ' CLOSE SQL CONNECTION
    '=========================================================
    rs.Close
    conn.Close
    
    Set rs = Nothing
    Set conn = Nothing
    Set ws = Nothing
    Set wb = Nothing
    
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    
    MsgBox "Data successfully retrieved from SQL Server." & vbCrLf & _
           "Output file:" & vbCrLf & _
           OutputPath, _
           vbInformation, "Success"
    
    Exit Sub

ErrorHandler:

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    
    On Error Resume Next
    
    If Not rs Is Nothing Then
        If rs.State <> 0 Then rs.Close
    End If
    
    If Not conn Is Nothing Then
        If conn.State <> 0 Then conn.Close
    End If
    
    MsgBox "Error: " & Err.Number & vbCrLf & _
           Err.Description, _
           vbCritical, "SQL / Excel Error"

End Sub

