function main(
  workbook: ExcelScript.Workbook,
  requestingSection: string,
  requestDate: string,
  reactivationDate: string,
  userIds: string[],
  userNames: string[]
) {

  // =========================================================
  // SETTINGS
  // =========================================================

  const sheetName = "Sheet1";
  const maxRows = 15;

  // =========================================================
