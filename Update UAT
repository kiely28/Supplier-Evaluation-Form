🔧 STEP 2: Add Log Writer Procedure

Sub WriteLog(supplierCode As String, _
             fileName As String, _
             status As String, _
             reason As String, _
             Optional details As String = "")
    
    Dim logWS As Worksheet
    Dim nextRow As Long
    
    Set logWS = GetLogSheet()
    nextRow = logWS.Cells(logWS.Rows.Count, "A").End(xlUp).Row + 1
    
    With logWS
        .Cells(nextRow, "A").Value = Date
        .Cells(nextRow, "B").Value = Time
        .Cells(nextRow, "C").Value = supplierCode
        .Cells(nextRow, "D").Value = fileName
        .Cells(nextRow, "E").Value = status
        .Cells(nextRow, "F").Value = reason
        .Cells(nextRow, "G").Value = details
    End With
End Sub


