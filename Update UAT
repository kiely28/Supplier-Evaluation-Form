Function GetLogSheet() As Worksheet
    Dim ws As Worksheet
    
    On Error Resume Next
    Set ws = ThisWorkbook.Sheets("Process_Log")
    On Error GoTo 0
    
    If ws Is Nothing Then
        Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        ws.Name = "Process_Log"
        
        ws.Range("A1:G1").Value = Array( _
            "Date", "Time", "Supplier Code", _
            "File Name", "Status", "Reason", "Details")
        
        ws.Rows(1).Font.Bold = True
        ws.Columns("A:G").AutoFit
    End If
    
    Set GetLogSheet = ws
End Function


