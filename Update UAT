🔧 STEP 1: Create / Get Log Sheet (Once)

✅ Add this helper function

Function GetLogSheet() As Worksheet
    Dim ws As Worksheet
    
    On Error Resume Next
    Set ws = ThisWorkbook.Sheets("Process_Log")
    On Error GoTo 0
    
    If ws Is Nothing Then
        Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        ws.Name = "Process_Log"
        
        ws.Range("A1:G1").Value = Array( _
            "Date", "Time", "Supplier Code", _
            "File Name", "Status", "Reason", "Details")
        
        ws.Rows(1).Font.Bold = True
        ws.Columns("A:G").AutoFit
    End If
    
    Set GetLogSheet = ws
End Function


---

🔧 STEP 2: Add Log Writer Procedure

Sub WriteLog(supplierCode As String, _
             fileName As String, _
             status As String, _
             reason As String, _
             Optional details As String = "")
    
    Dim logWS As Worksheet
    Dim nextRow As Long
    
    Set logWS = GetLogSheet()
    nextRow = logWS.Cells(logWS.Rows.Count, "A").End(xlUp).Row + 1
    
    With logWS
        .Cells(nextRow, "A").Value = Date
        .Cells(nextRow, "B").Value = Time
        .Cells(nextRow, "C").Value = supplierCode
        .Cells(nextRow, "D").Value = fileName
        .Cells(nextRow, "E").Value = status
        .Cells(nextRow, "F").Value = reason
        .Cells(nextRow, "G").Value = details
    End With
End Sub


