23. Complete Office Script

Use this as the script.

function main(
  workbook: ExcelScript.Workbook,
  requestingSection: string,
  requestDate: string,
  reactivationDate: string,
  userIds: string[],
  userNames: string[],
  approval1: string,
  approval2: string,
  approval3: string,
  approval4: string,
  approval1Signature: string,
  approval2Signature: string,
  approval3Signature: string,
  approval4Signature: string
) {
  //==================================================
  // GET WORKSHEET
  //==================================================

  const sheet = workbook.getWorksheet("Reactivation Form 2");

  if (!sheet) {
    throw new Error(
      'Worksheet "Reactivation Form 2" was not found.'
    );
  }

  //==================================================
  // BASIC INFORMATION
  //==================================================

  sheet.getRange("G7").setValue(requestingSection || "");
  sheet.getRange("E8").setValue(requestDate || "");
  sheet.getRange("F9").setValue(reactivationDate || "");

  //==================================================
  // CLEAR USER INFORMATION
  //==================================================

  sheet.getRange("C12:C26").clear(
    ExcelScript.ClearApplyTo.contents
  );

  sheet.getRange("H12:H26").clear(
    ExcelScript.ClearApplyTo.contents
  );

  //==================================================
  // INSERT USERS
  //==================================================

  const maxUsers = 15;

  const safeUserIds = Array.isArray(userIds)
    ? userIds
    : [];

  const safeUserNames = Array.isArray(userNames)
    ? userNames
    : [];

  const userCount = Math.min(
    Math.max(safeUserIds.length, safeUserNames.length),
    maxUsers
  );

  for (let i = 0; i < userCount; i++) {

    const row = 12 + i;

    const userId =
      safeUserIds[i] !== undefined &&
      safeUserIds[i] !== null
        ? String(safeUserIds[i])
        : "";

    const userName =
      safeUserNames[i] !== undefined &&
      safeUserNames[i] !== null
        ? String(safeUserNames[i])
        : "";

    sheet.getRange(`C${row}`).setValue(userId);
    sheet.getRange(`H${row}`).setValue(userName);
  }

  //==================================================
  // CLEAR APPROVER NAMES
  //==================================================

  sheet.getRange("C49").clear(
    ExcelScript.ClearApplyTo.contents
  );

  sheet.getRange("I49:K49").clear(
    ExcelScript.ClearApplyTo.contents
  );

  //==================================================
  // INSERT APPROVER NAMES
  //==================================================

  sheet.getRange("C49").setValue(approval1 || "");
  sheet.getRange("I49").setValue(approval2 || "");
  sheet.getRange("J49").setValue(approval3 || "");
  sheet.getRange("K49").setValue(approval4 || "");

  //==================================================
  // CLEAR OLD SIGNATURES
  //==================================================

  sheet.getRange("D46").clear(
    ExcelScript.ClearApplyTo.contents
  );

  sheet.getRange("I46:K46").clear(
    ExcelScript.ClearApplyTo.contents
  );

  //==================================================
  // INSERT SIGNATURES
  //==================================================

  if (approval1Signature) {
    insertSignature(
      sheet,
      approval1Signature,
      "D46"
    );
  }

  if (approval2Signature) {
    insertSignature(
      sheet,
      approval2Signature,
      "I46"
    );
  }

  if (approval3Signature) {
    insertSignature(
      sheet,
      approval3Signature,
      "J46"
    );
  }

  if (approval4Signature) {
    insertSignature(
      sheet,
      approval4Signature,
      "K46"
    );
  }
}


/**
 * Inserts a Base64 PNG signature into a specified cell.
 */
function insertSignature(
  sheet: ExcelScript.Worksheet,
  base64Data: string,
  cellAddress: string
) {
  if (!base64Data) {
    return;
  }

  let cleanBase64 = base64Data;

  // Remove data URI prefix if one happens to be supplied.
  // The Power Automate flow should normally provide raw Base64.
  if (cleanBase64.indexOf(",") >= 0) {
    cleanBase64 =
      cleanBase64.substring(
        cleanBase64.indexOf(",") + 1
      );
  }

  const image = sheet.addImage(cleanBase64);

  const range = sheet.getRange(cellAddress);

  const left = range.getLeft();
  const top = range.getTop();
  const width = range.getWidth();
  const height = range.getHeight();

  image.setLeft(left);
  image.setTop(top);

  // Keep the signature inside the target cell.
  image.setWidth(Math.min(width, 120));
  image.setHeight(Math.min(height, 45));
}

Important note about the signature implementation

The addImage() method is being used to insert the Base64 image into the worksheet. If your template has merged cells or the signature boxes are larger/smaller than the values above, we can adjust the image sizing after you test it.

The script deliberately uses:

workbook.getWorksheet("Reactivation Form 2")

rather than:

workbook.getActiveWorksheet()

which is the safer approach for Power Automate.


