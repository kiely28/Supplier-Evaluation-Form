    CountRows(
        Filter(
            'SE Evaluation List',
            Sections.Value = Dropdown_Section.Selected.Title &&
            'Created By'.Email = User().Email &&
            'Evaluation Year' = Year(Today())
        )
    ) > 0,

    Notify(
        "You already submitted this evaluation for this year.",
        NotificationType.Error
    ),
    
    Clear(colSupplierComments);

    ForAll(
        Gallery_Suppliers_New.AllItems As S,
        Collect(
            colSupplierComments,
            {
                SupplierID: S.ID,
                SupplierComment: S.txt_Comment.Text
            }
        )
    );

    ForAll(
        colAnswers,
        Patch(
            'SE Evaluation List',
            Defaults('SE Evaluation List'),
            {
                Sections: {
                    Id: Dropdown_Section.Selected.ID,
                    Value: Dropdown_Section.Selected.Title
                },
                Suppliers: {
                    Id: SupplierID,
                    Value: SupplierName
                },
                Questions: {
                    Id: QuestionID,
                    Value: QuestionTitle
                },
                Score: { Value: Score },

                'Evaluation Year': Year(Today()),

                //Comment: Comment
                Comment:
            LookUp(
                colSupplierComments,
                SupplierID = ThisRecord.SupplierID
            ).SupplierComment

            }
        )
    );

    Notify(
        "Evaluation submitted successfully.",
        NotificationType.Success
    );

    Clear(colAnswers)
)





