    Notify(
        "Please select a section first.",
        NotificationType.Error
    ),

    CountRows(colAnswers) = 0,

    Notify(
        "Please answer the evaluation before submitting.",
        NotificationType.Error
    ),

    CountRows(colAnswers) <>
(
    CountRows(Gallery_Suppliers_New.AllItems) *
    CountRows(colQuestions)
),

Notify(
    "Please answer all radio evaluation questions.",
    NotificationType.Error
),

