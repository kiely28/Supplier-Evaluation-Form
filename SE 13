With this:

Dim colVendor As Long
Dim lastCol As Long
Dim j As Long

'Find Vendor column dynamically
colVendor = 0
lastCol = wsTarget.Cells(1, wsTarget.Columns.Count).End(xlToLeft).Column

For j = 1 To lastCol
    If Trim(wsTarget.Cells(1, j).Value) = "Vendor" Then
        colVendor = j
        Exit For
    End If
Next j

If colVendor = 0 Then
    MsgBox "Vendor column not found in " & wbTarget.Name, vbExclamation
Else
    lastRowTarget = wsTarget.Cells(wsTarget.Rows.Count, colVendor).End(xlUp).Row

    For r = 2 To lastRowTarget
        If Trim(wsTarget.Cells(r, "C").Value) = "" Then
            wsTarget.Cells(r, "C").Value = wsTarget.Cells(r, colVendor).Value
        End If
    Next r
End If

