Option Explicit

Sub UpdateSummary()

    Const SOURCE_FILE As String = "D:\SE Evaluation List.xlsx"
    Const SUMMARY_FILE As String = "D:\Summary.xlsx"

    Const HEADER_ROW_SOURCE As Long = 1
    Const HEADER_ROW_SUMMARY As Long = 11
    Const FIRST_DATA_ROW_SUMMARY As Long = 12

    Dim wbSource As Workbook
    Dim wbSummary As Workbook
    Dim wsSource As Worksheet
    Dim wsSummary As Worksheet

    Dim lastRow As Long
    Dim lastCol As Long

    Dim dictScore As Object
    Dim dictCount As Object
    Dim dictRows As Object
    Dim dictCols As Object

    Dim key As String
    Dim supplier As String
    Dim question As String
    Dim fiscal As String
    Dim score As Double

    Dim i As Long
    Dim r As Long
    Dim c As Long

    Dim opCol As Long

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    Set wbSource = Workbooks.Open(SOURCE_FILE)

    'Refresh Power Query / Connections
    wbSource.RefreshAll
    Application.CalculateUntilAsyncQueriesDone

    Set wsSource = wbSource.Sheets(1)

    Set dictScore = CreateObject("Scripting.Dictionary")
    Set dictCount = CreateObject("Scripting.Dictionary")

    lastRow = wsSource.Cells(wsSource.Rows.Count, "C").End(xlUp).Row

    '=======================================
    'Collect totals
    '=======================================
    For i = 2 To lastRow

        supplier = Trim(wsSource.Cells(i, "C").Value)
        question = Trim(wsSource.Cells(i, "B").Value)
        score = Val(wsSource.Cells(i, "E").Value)
        fiscal = Trim(wsSource.Cells(i, "F").Value)

        If supplier <> "" And question <> "" Then

            key = supplier & "|" & question & "|" & fiscal

            If dictScore.Exists(key) Then
                dictScore(key) = dictScore(key) + score
                dictCount(key) = dictCount(key) + 1
            Else
                dictScore.Add key, score
                dictCount.Add key, 1
            End If

        End If

    Next i

    Set wbSummary = Workbooks.Open(SUMMARY_FILE)
    Set wsSummary = wbSummary.Sheets(1)

    opCol = Application.Match("OP Code", wsSummary.Rows(HEADER_ROW_SUMMARY), 0)

    Set dictRows = CreateObject("Scripting.Dictionary")
    Set dictCols = CreateObject("Scripting.Dictionary")

    'Supplier rows
    r = FIRST_DATA_ROW_SUMMARY

    Do While wsSummary.Cells(r, opCol).Value <> ""

        dictRows(Trim(wsSummary.Cells(r, opCol).Value)) = r
        r = r + 1

    Loop

    'Question columns
    lastCol = wsSummary.Cells(HEADER_ROW_SUMMARY, wsSummary.Columns.Count).End(xlToLeft).Column

    For c = opCol + 1 To lastCol

        If Trim(wsSummary.Cells(HEADER_ROW_SUMMARY, c).Value) <> "" Then

            dictCols(Trim(wsSummary.Cells(HEADER_ROW_SUMMARY, c).Value)) = c

        End If

    Next c

    '=======================================
    'Write rounded averages
    '=======================================
    Dim arr
    Dim avgScore As Double

    For Each key In dictScore.Keys

        arr = Split(key, "|")

        supplier = arr(0)
        question = arr(1)

        avgScore = dictScore(key) / dictCount(key)

        If dictRows.Exists(supplier) Then

            If dictCols.Exists(question) Then

                wsSummary.Cells( _
                    dictRows(supplier), _
                    dictCols(question) _
                ).Value = WorksheetFunction.Round(avgScore, 0)

            End If

        End If

    Next key

    wbSummary.Save
    wbSource.Close False
    wbSummary.Close True

    Application.ScreenUpdating = True

    MsgBox "Summary successfully updated."

End Sub

