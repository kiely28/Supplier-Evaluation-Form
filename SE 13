Option Explicit

Sub WaitForRefresh(wb As Workbook)

    Dim cn As WorkbookConnection
    Dim Refreshing As Boolean

    Do

        Refreshing = False

        DoEvents

        For Each cn In wb.Connections

            On Error Resume Next

            Select Case cn.Type

                Case xlConnectionTypeOLEDB

                    If cn.OLEDBConnection.Refreshing Then
                        Refreshing = True
                    End If

                Case xlConnectionTypeODBC

                    If cn.ODBCConnection.Refreshing Then
                        Refreshing = True
                    End If

            End Select

            On Error GoTo 0

            If Refreshing Then Exit For

        Next cn

    Loop While Refreshing

End Sub


