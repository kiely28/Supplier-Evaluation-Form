VBA Macro Code

Sub ImportSupplierEvaluation()

    Dim evalFolder As String
    Dim evalFile As String
    Dim opCode As String

    Dim wbEval As Workbook
    Dim wsEval As Worksheet

    Dim wbTemp As Workbook
    Dim wsTemp As Worksheet

    Dim findRow As Range
    Dim srcRange As Range
    Dim destCell As Range

    ' === SETTINGS ===
    evalFolder = ThisWorkbook.Path & "\Supplier Evaluation Form\"
    
    ' If TEMPLATE is already open
    Set wbTemp = Workbooks("Template.xlsx") ' <-- CHANGE NAME IF NEEDED
    Set wsTemp = wbTemp.Sheets(1)            ' <-- CHANGE SHEET IF NEEDED

    ' Get first Excel file in folder
    evalFile = Dir(evalFolder & "*.xlsx")

    Do While evalFile <> ""

        ' Skip temporary Excel files
        If Left(evalFile, 2) <> "~$" Then

            ' Get OP_Code (first 6 characters of filename)
            opCode = Left(evalFile, 6)

            ' Find OP_Code in Template Column N starting Row 12
            Set findRow = wsTemp.Range("N12:N" & wsTemp.Rows.Count).Find( _
                            What:=opCode, _
                            LookAt:=xlWhole, _
                            LookIn:=xlValues)

            ' If OP_Code exists in template
            If Not findRow Is Nothing Then

                ' Open Evaluation Form
                Set wbEval = Workbooks.Open(evalFolder & evalFile)
                Set wsEval = wbEval.Sheets(1) ' <-- CHANGE IF NEEDED

                ' Copy Column C, Rows 10 to 21 (merged-safe)
                Set srcRange = wsEval.Range("C10:C21")

                ' Paste to Template Column P, Row 13
                Set destCell = wsTemp.Range("P13")
                destCell.Resize(srcRange.Rows.Count, 1).Value = srcRange.Value

                ' Close Evaluation Form (no save)
                wbEval.Close SaveChanges:=False

            End If

        End If

        ' Next file
        evalFile = Dir

    Loop

    MsgBox "Supplier Evaluation data import completed.", vbInformation

End Sub


