🧩 PART 11: SAVE DATA

Button → OnSelect:

ForAll(
    Gallery_Suppliers.AllItems,
    With(
        {sup: ThisRecord},
        ForAll(
            Gallery_Questions_H.AllItems,
            Patch(
                'SE Evaluation List',
                Defaults('SE Evaluation List'),
                {
                    Section: Dropdown_Section.Selected,
                    Supplier: sup,
                    Question: ThisRecord,
                    Score: Radio_Score.Selected.Value
                }
            )
        )
    )
)


