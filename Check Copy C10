Sub UpdateSupplierEvaluationSummary()

    Dim evalFolder As String
    Dim evalFile As String
    Dim evalWB As Workbook
    Dim evalWS As Worksheet

    Dim summaryWB As Workbook
    Dim summaryWS As Worksheet

    Dim supplierCode As String
    Dim findCell As Range
    Dim copyValue As Variant

    ' Path
    evalFolder = "D:\Supplier Evaluation Form\"

    ' Open summary file once
    Set summaryWB = Workbooks.Open("D:\FY25 Supplier periodic evaluation Summary.xlsx")
    Set summaryWS = summaryWB.Sheets(2)

    Application.ScreenUpdating = False
    Application.EnableEvents = False

    evalFile = Dir(evalFolder & "*.xls*")

    Do While evalFile <> ""

        supplierCode = Trim(Left(evalFile, 6))
        Debug.Print "Checking file:", evalFile, "Code:", supplierCode

        ' SAFE FIND
        Set findCell = summaryWS.Range("N12:N" & summaryWS.Cells(summaryWS.Rows.Count, "N").End(xlUp).Row) _
            .Find(What:=supplierCode, _
                  LookIn:=xlValues, _
                  LookAt:=xlWhole, _
                  MatchCase:=False)

        If Not findCell Is Nothing Then

            Debug.Print "Match found at row:", findCell.Row

            Set evalWB = Workbooks.Open(evalFolder & evalFile, ReadOnly:=True)
            Set evalWS = evalWB.Sheets(1)

            ' Get value from merged range safely
            If evalWS.Range("C10").MergeCells Then
                copyValue = evalWS.Range("C10").MergeArea.Cells(1, 1).Value
            Else
                copyValue = evalWS.Range("C10").Value
            End If

            Debug.Print "Copied value:", copyValue

            ' Paste to Column P
            summaryWS.Cells(findCell.Row, "P").Value = copyValue

            evalWB.Close SaveChanges:=False

        Else
            Debug.Print "NO MATCH for:", supplierCode
        End If

        evalFile = Dir
    Loop

    summaryWB.Save

    Application.ScreenUpdating = True
    Application.EnableEvents = True

    MsgBox "Supplier Evaluation Summary updated successfully!", vbInformation

End Sub


