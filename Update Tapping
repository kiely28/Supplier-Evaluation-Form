✔ Step 2: Use JavaScript

<script>
    // Get hostname (browser)
    document.getElementById('<%=hfHostName.ClientID%>').value = window.location.hostname;

    // Get IP via WebRTC (works in LAN)
    function getIP(callback) {
        var pc = new RTCPeerConnection({ iceServers: [] });
        pc.createDataChannel("");
        pc.createOffer().then(offer => pc.setLocalDescription(offer));

        pc.onicecandidate = function (ice) {
            if (!ice || !ice.candidate || !ice.candidate.candidate) return;
            var ip = ice.candidate.candidate.split(" ")[4];
            callback(ip);
        };
    }

    getIP(function (ip) {
        document.getElementById('<%=hfClientIP.ClientID%>').value = ip;
    });
</script>


