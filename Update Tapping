ALTER PROCEDURE MA_InsertAttendee
    @MeetingId INT,
    @EmployeeNo NVARCHAR(50)
AS
BEGIN
    SET NOCOUNT ON;

    -- Check if already tapped in
    IF EXISTS (
        SELECT 1 
        FROM tbl_participants 
        WHERE MeetingId = @MeetingId 
        AND EmployeeNo = @EmployeeNo
    )
    BEGIN
        SELECT 0 AS Result; -- Already tapped
        RETURN;
    END

    -- Insert new record
    INSERT INTO tbl_participants
    (
        MeetingId,
        EmployeeNo,
        TapIn
    )
    VALUES
    (
        @MeetingId,
        @EmployeeNo,
        GETDATE()
    );

    SELECT 1 AS Result; -- Success
END


