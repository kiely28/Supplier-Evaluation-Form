Function GetErrorLogSheet() As Worksheet
    Dim ws As Worksheet

    On Error Resume Next
    Set ws = ThisWorkbook.Sheets("Error Log")
    On Error GoTo 0

    If ws Is Nothing Then
        Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        ws.Name = "Error Log"

        ws.Range("A1:F1").Value = Array( _
            "No.", _
            "Datetime", _
            "SupplierCode", _
            "Last Archive Src", _
            "Err Description", _
            "Remarks")

        ws.Rows(1).Font.Bold = True
        ws.Columns("A:F").AutoFit
    End If

    Set GetErrorLogSheet = ws
End Function

Sub LogRuntimeError( _
    supplierCode As String, _
    errDesc As String, _
    Optional remarks As String = "Unhandled runtime error")

    Dim ws As Worksheet
    Dim nextRow As Long

    Set ws = GetErrorLogSheet()

    nextRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row + 1

    ws.Cells(nextRow, "A").Value = nextRow - 1        ' No.
    ws.Cells(nextRow, "B").Value = Now                ' Datetime
    ws.Cells(nextRow, "C").Value = supplierCode       ' SupplierCode
    ws.Cells(nextRow, "D").Value = gLastArchiveSRC    ' Last Archive Src
    ws.Cells(nextRow, "E").Value = errDesc            ' Err Description
    ws.Cells(nextRow, "F").Value = remarks             ' Remarks

    ws.Columns("B").NumberFormat = "mm/dd/yyyy hh:mm:ss"
End Sub
