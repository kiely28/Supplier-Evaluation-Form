Sub UpdateSupplierEvaluationSummary()
    Dim evalFolder As String, evalfile As String
    Dim evalWB As Workbook
    'Dim SummaryWB As Workbook, SummaryWS As Worksheet
    Dim cfgWS As Worksheet
    Dim findCell As Range

    'Dim supplierCode As String
    Dim materialType As String
    Dim lastCfgRow As Long
    Dim r As Long

    Dim srcWS As Worksheet
    Dim srcSheetName As String

    Dim destRow As Long
    Dim hasMismatch As Boolean
    
    'Dim CompletedFolder As String
    'Dim InvalidFolder As String
    Dim archiveFolder As String
    
    Dim missingSheetName As String
    Dim materialMismatchReason As String

    ' ===== PATHS =====
    evalfile = Trim(ThisWorkbook.Sheets("Main").Range("B5").Value)
    evalFolder = Trim(ThisWorkbook.Sheets("Main").Range("B8").Value) ' "D:\Supplier Evaluation Form\"
    
    If Right(evalFolder, 1) <> "\" Then evalFolder = evalFolder & "\"
    
    CompletedFolder = evalFolder & "Completed\"
    InvalidFolder = evalFolder & "Invalid\"
    archiveFolder = evalFolder & "Archive\"
    
    ' ===== CREATE FOLDERS IF NOT EXIST =====
    If Dir(CompletedFolder, vbDirectory) = "" Then MkDir CompletedFolder
    If Dir(InvalidFolder, vbDirectory) = "" Then MkDir InvalidFolder
    If Dir(archiveFolder, vbDirectory) = "" Then MkDir archiveFolder

