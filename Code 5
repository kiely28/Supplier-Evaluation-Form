Sub ClearTimeLog()
    With ThisWorkbook.Sheets(1)
        .Range("B13:C15").ClearContents
        .Range("H10:I12").ClearContents
    End With
End Sub

Sub LogStartTime()
    With ThisWorkbook.Sheets(1)
        .Range("H10").Value = "Start Date/Time:"
        .Range("I10").Value = Now
        .Range("I10").NumberFormat = "mm/dd/yyyy hh:mm:ss"
    End With
End Sub

Sub LogEndTimeAndDuration()
    Dim ws As Worksheet
    Dim startTime As Date
    Dim endTime As Date

    Set ws = ThisWorkbook.Sheets(1)

    startTime = ws.Range("I10").Value
    endTime = Now

    ws.Range("H11").Value = "End Date/Time:"
    ws.Range("I11").Value = endTime
    ws.Range("I11").NumberFormat = "mm/dd/yyyy hh:mm:ss"

    ws.Range("H12").Value = "Duration"
    ws.Range("I12").Value = endTime - startTime
    ws.Range("I12").NumberFormat = "[hh]:mm:ss"
    
    'Call LogRunHistory
    
'    If ThisWorkbook.Saved = False Then
'        ThisWorkbook.Save
'    End If
    
End Sub

Sub LogRunHistory()
    Dim wsSum As Worksheet
    Dim wsHist As Worksheet
    Dim nextRow As Long
    Dim runNumber As Long

    Set wsSum = ThisWorkbook.Sheets(1)
    Set wsHist = ThisWorkbook.Sheets("Activity Log")

    ' Find next empty row
    nextRow = wsHist.Cells(wsHist.Rows.Count, "A").End(xlUp).Row + 1

    ' Auto run number
    If nextRow = 2 Then
        runNumber = 1
    Else
        runNumber = wsHist.Cells(nextRow - 1, "A").Value + 1
    End If

    wsHist.Cells(nextRow, "A").Value = runNumber
    wsHist.Cells(nextRow, "B").Value = wsSum.Range("I10").Value
    wsHist.Cells(nextRow, "C").Value = wsSum.Range("I11").Value
    wsHist.Cells(nextRow, "D").Value = wsSum.Range("I12").Value

    wsHist.Columns("B:C").NumberFormat = "mm/dd/yyyy hh:mm:ss"
    wsHist.Columns("D").NumberFormat = "[hh]:mm:ss"

End Sub


Sub SaveAfterLog()
    If ThisWorkbook.Saved = False Then
        ThisWorkbook.Save
    End If
End Sub

