Sub LogEndTimeAndDuration()

    Dim ws As Worksheet
    Dim startTime As Date
    Dim endTime As Date

    Set ws = ThisWorkbook.Sheets("Summary")

    startTime = ws.Range("A2").Value
    endTime = Now

    ws.Range("A3").Value = endTime
    ws.Range("A3").NumberFormat = "mm/dd/yyyy hh:mm:ss"

    ws.Range("A4").Value = endTime - startTime
    ws.Range("A4").NumberFormat = "[hh]:mm:ss"

End Sub


