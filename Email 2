Sub FinalizeSummaryAndResults()
    Dim completedCount As Long
    Dim invalidCount As Long
    Dim totalSuppliers As Long

    On Error Resume Next

    ' Save summary workbook
    If Not gSummaryWB Is Nothing Then
        gSummaryWB.Save
    End If

    ' Recompute counts
    completedCount = CountExcelFiles(gCompletedFolder)
    invalidCount = CountExcelFiles(gInvalidFolder)
    totalSuppliers = CountSuppliersInSummary(gSummaryWS)

    With ThisWorkbook.Sheets(1)
        .Range("B14").Value = "Completed:"
        .Range("C14").Value = completedCount & "/" & totalSuppliers & " form(s)"

        .Range("B15").Value = "Invalid:"
        .Range("C15").Value = invalidCount & " form(s)"
    End With

    On Error GoTo 0
End Sub

