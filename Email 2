5️⃣ ⭐ Append Run to History Table (Core Feature)

Sub LogRunHistory()

    Dim wsSum As Worksheet
    Dim wsHist As Worksheet
    Dim nextRow As Long
    Dim runNumber As Long

    Set wsSum = ThisWorkbook.Sheets("Summary")
    Set wsHist = ThisWorkbook.Sheets("History")

    ' Find next empty row
    nextRow = wsHist.Cells(wsHist.Rows.Count, "A").End(xlUp).Row + 1

    ' Auto run number
    If nextRow = 2 Then
        runNumber = 1
    Else
        runNumber = wsHist.Cells(nextRow - 1, "A").Value + 1
    End If

    wsHist.Cells(nextRow, "A").Value = runNumber
    wsHist.Cells(nextRow, "B").Value = wsSum.Range("A2").Value
    wsHist.Cells(nextRow, "C").Value = wsSum.Range("A3").Value
    wsHist.Cells(nextRow, "D").Value = wsSum.Range("A4").Value

    wsHist.Columns("B:C").NumberFormat = "mm/dd/yyyy hh:mm:ss"
    wsHist.Columns("D").NumberFormat = "[hh]:mm:ss"

End Sub


