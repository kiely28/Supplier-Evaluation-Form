declare @meetingID nvarchar(50) = 'MA-202603-093'
 
 
	----- NEW VERSION NA MAY EMP ID NA
	SELECT
		muser.[EmployeeNo]
		,CONCAT(muser.FirstName, ' ', COALESCE(muser.MiddleName, ''), ' ', muser.LastName) AS FullName
		,muser.[Grade]
		,CONCAT(muser.DivisionName, '/', muser.DepartmentName, '/', muser.SectionName) AS Department
		,tpart.[TapIn]
		,tpart.[TapOut]
		FROM [db_MeetingAttendance].[dbo].[Tbl_Participants] tpart
			INNER JOIN [db_EPPIIIP_New].[dbo].[TBL_M_USERMASTER] muser
		ON 
			muser.EmployeeNo = tpart.EmployeeNo
		WHERE MeetingId = @meetingID
	UNION 
	SELECT
		muser.[EmployeeNo]
		,CONCAT(muser.FirstName, ' ', COALESCE(muser.MiddleName, ''), ' ', muser.LastName) AS FullName
		,muser.[Grade]
		,CONCAT(muser.DivisionName, '/', muser.DepartmentName, '/', muser.SectionName) AS Department
		,tpart.[TapIn]
		,tpart.[TapOut]
		FROM [db_MeetingAttendance].[dbo].[Tbl_Participants] tpart
			INNER JOIN [db_EPPIIIP_New].[dbo].[vw_UserMaster_CardSerialNo] muser
		ON 
			muser.CardSerialNo = tpart.CardSerialNo
		WHERE MeetingId = @meetingID
		ORDER BY tpart.TapIn DESC;



