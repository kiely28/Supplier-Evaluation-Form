Sub UpdatePCMSLoginFileName_Dynamic()

    Dim wb As Workbook
    Dim wsPCMS As Worksheet
    Dim wsGoods As Worksheet
    Dim filePath As String
    Dim lastRowGoods As Long
    Dim lastRowPCMS As Long
    Dim dict As Object
    Dim i As Long
    Dim controlNum As String
    Dim appliedBy As String
    Dim colAppliedBy As Long
    Dim colControlNum As Long
    Dim headerCell As Range
    
    filePath = "D:\Triangular\MaterialWithDeficit.xlsx"
    
    ' Check if file exists
    If Dir(filePath) = "" Then
        MsgBox "File not found: " & filePath, vbExclamation
        Exit Sub
    End If
    
    ' Open workbook
    Set wb = Workbooks.Open(filePath)
    
    ' Check sheets
    On Error Resume Next
    Set wsPCMS = wb.Sheets("PCMS_LOGIN")
    Set wsGoods = wb.Sheets("GOODS")
    On Error GoTo 0
    
    If wsPCMS Is Nothing Then
        MsgBox "Sheet PCMS_LOGIN not found.", vbExclamation
        wb.Close False
        Exit Sub
    End If
    
    If wsGoods Is Nothing Then
        MsgBox "Sheet GOODS not found.", vbExclamation
        wb.Close False
        Exit Sub
    End If
    
    ' ================================
    ' Dynamic Column Detection (GOODS)
    ' ================================
    
    colAppliedBy = 0
    colControlNum = 0
    
    For Each headerCell In wsGoods.Rows(1).Cells
        If Trim(UCase(headerCell.Value)) = "APPLIEDBY" Then
            colAppliedBy = headerCell.Column
        End If
        
        If Trim(UCase(headerCell.Value)) = "CONTROLNUMBER" Then
            colControlNum = headerCell.Column
        End If
        
        If colAppliedBy > 0 And colControlNum > 0 Then Exit For
    Next headerCell
    
    If colAppliedBy = 0 Or colControlNum = 0 Then
        MsgBox "Required headers (AppliedBy / ControlNumber) not found in GOODS sheet.", vbExclamation
        wb.Close False
        Exit Sub
    End If
    
    ' ================================
    ' Build Dictionary
    ' ================================
    
    Set dict = CreateObject("Scripting.Dictionary")
    
    lastRowGoods = wsGoods.Cells(wsGoods.Rows.Count, colControlNum).End(xlUp).Row
    
    For i = 2 To lastRowGoods
        appliedBy = Trim(wsGoods.Cells(i, colAppliedBy).Value)
        controlNum = Trim(wsGoods.Cells(i, colControlNum).Value)
        
        If controlNum <> "" Then
            If Not dict.exists(controlNum) Then
                dict.Add controlNum, appliedBy
            End If
        End If
    Next i
    
    ' ================================
    ' Update PCMS_LOGIN
    ' ================================
    
    wsPCMS.Range("D1").Value = "FILENAME"
    
    lastRowPCMS = wsPCMS.Cells(wsPCMS.Rows.Count, "A").End(xlUp).Row
    
    For i = 2 To lastRowPCMS
        controlNum = Trim(wsPCMS.Cells(i, 1).Value)
        
        If dict.exists(controlNum) Then
            wsPCMS.Cells(i, 4).Value = dict(controlNum) & ".xlsx"
        Else
            wsPCMS.Cells(i, 4).Value = ""
        End If
    Next i
    
    MsgBox "Update completed successfully.", vbInformation

End Sub


