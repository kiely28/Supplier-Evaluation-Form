Option Explicit

Sub UpdateSupplierEvaluationSummary()

    Dim evalFolder As String, evalFile As String
    Dim evalWB As Workbook, evalWS As Worksheet
    Dim summaryWB As Workbook, summaryWS As Worksheet
    Dim findCell As Range
    Dim supplierCode As String
    Dim materialType As String

    Dim srcStart As Variant, srcEnd As Variant
    Dim destCols As Variant
    Dim i As Long

    ' ==========================
    ' PATHS
    ' ==========================
    evalFolder = "D:\Supplier Evaluation Form\"

    Set summaryWB = Workbooks.Open("D:\FY25 Supplier periodic evaluation Summary.xlsx")
    Set summaryWS = summaryWB.Sheets(2) ' adjust if needed

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    evalFile = Dir(evalFolder & "*.xls*")

    Do While evalFile <> ""

        supplierCode = Trim(Left(evalFile, 6))

        Set findCell = summaryWS.Range("N12:N" & _
            summaryWS.Cells(summaryWS.Rows.Count, "N").End(xlUp).Row) _
            .Find(supplierCode, LookIn:=xlValues, LookAt:=xlWhole, MatchCase:=False)

        If Not findCell Is Nothing Then

            materialType = UCase(Trim(summaryWS.Cells(findCell.Row, "L").Value))

            Set evalWB = Workbooks.Open(evalFolder & evalFile, ReadOnly:=True)
            Set evalWS = evalWB.Sheets(1)

            ' ==========================
            ' MATERIAL TYPE MAPPING
            ' ==========================
            Select Case materialType

                ' =====================================================
                Case "DIRECT MATERIAL"
                    srcStart = Array(10,22,35,47,59,76,89,103,115,131,146,159,180,192,206,223,234,249,262)
                    srcEnd   = Array(21,34,46,58,75,88,102,114,130,145,158,179,191,205,222,233,248,261,272)
                    destCols = Array("P","Q","R","S","T","U","V","W","X","Y","Z","AA","AB","AC","AD","AE","AF","AG","AI")
                    ' AH intentionally skipped

                ' =====================================================
                Case "INDIRECT MATERIAL"
                    srcStart = Array(10,22,35,47,59,76,89,103,115,131,146,159,180,192,206,223,234,249,262)
                    srcEnd   = Array(21,34,46,58,75,88,102,114,130,145,158,179,191,205,222,233,248,261,272)
                    destCols = Array("P","Q","R","S","T","U","V","W","X","Y","Z","AA","AB","AC","AD","AE","AF","AG","AI")
                    ' AH intentionally skipped (M19)

                ' =====================================================
                Case "PROFESSIONAL SERVICE"
                    srcStart = Array(10,22,35,47,58,69,82,99,116,131,143,157,174)
                    srcEnd   = Array(21,34,46,57,68,81,98,115,130,142,156,173,184)
                    destCols = Array("P","Q","R","S","T","U","V","W","X","Y","Z","AA","AI")
