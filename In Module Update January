✅ STEP 1: GET DATA SP (FOR DATATABLE)

You already have this, but confirming format:

sp_Students_GetAll

ALTER PROCEDURE sp_Students_GetAll
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        s.Id,
        s.ControlNo,
        s.SerialNo,
        s.Name,
        s.Quantity,
        c.CategoryName,
        l.LocationName,
        s.Age
    FROM Students s
    INNER JOIN tbl_Category c ON s.CategoryId = c.CategoryId
    INNER JOIN tbl_Location l ON s.LocationId = l.LocationId
    ORDER BY s.Id DESC;
END


---

✅ STEP 2: DbContext Method

public async Task<List<Student>> GetStudentsAsync()
{
    return await Students
        .FromSqlRaw("EXEC sp_Students_GetAll")
        .AsNoTracking()
        .ToListAsync();
}


