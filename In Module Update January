✅ STEP 3: Controller (IMPORTANT CHANGE)

👉 After Save → return same View with data

StudentsController.cs

public async Task<IActionResult> Create()
{
    ViewBag.CategoryList = await _context.GetCategoriesAsync();
    ViewBag.LocationList = await _context.GetLocationsAsync();
    ViewBag.StudentList = await _context.GetStudentsAsync(); // 👈 TABLE DATA
    return View(new Student());
}

[HttpPost]
[ValidateAntiForgeryToken]
public async Task<IActionResult> Create(Student student)
{
    if (!ModelState.IsValid)
    {
        ViewBag.CategoryList = await _context.GetCategoriesAsync();
        ViewBag.LocationList = await _context.GetLocationsAsync();
        ViewBag.StudentList = await _context.GetStudentsAsync();
        return View(student);
    }

    await _context.InsertStudentAsync(student);

    ViewBag.SuccessMessage = "Saved successfully.";
    ViewBag.FocusSerial = true;

    ViewBag.CategoryList = await _context.GetCategoriesAsync();
    ViewBag.LocationList = await _context.GetLocationsAsync();
    ViewBag.StudentList = await _context.GetStudentsAsync();

    return View(new Student()); // 👈 reset form
}


