Sub SetFiscalQuarterRange()
    Dim currentMonth As Integer
    
    ' Add 1 month to today's date, then extract the month number
    currentMonth = Month(DateAdd("m", 1, Date))
    
    With ThisWorkbook.Sheets(1)
        Select Case currentMonth
            Case 4 To 6 ' April to June
                .Range("C9").Value = 1
                .Range("D9").Value = "Apr"
                .Range("C10").Value = 3
                .Range("D10").Value = "Jun"
            Case 7 To 9 ' July to September
                .Range("C9").Value = 4
                .Range("D9").Value = "Jul"
                .Range("C10").Value = 6
                .Range("D10").Value = "Sep"
            Case 10 To 12 ' October to December
                .Range("C9").Value = 7
                .Range("D9").Value = "Oct"
                .Range("C10").Value = 9
                .Range("D10").Value = "Dec"
            Case 1 To 3 ' January to March
                .Range("C9").Value = 10
                .Range("D9").Value = "Jan"
                .Range("C10").Value = 12
                .Range("D10").Value = "Mar"
        End Select
    End With
End Sub


