Sub GetFiscalYear()
    Dim fiscalStart As Date
    Dim fiscalEnd As Date
    Dim currentDate As Date
    Dim fiscalYear As Integer
    Dim previousMonthDate As Date
    
    ' Define the start and end dates of the fiscal year
    fiscalStart = DateSerial(Year(Date), 4, 1) ' Fiscal year starts on April 1
    fiscalEnd = DateSerial(Year(Date) + 1, 3, 31) ' Fiscal year ends on March 31
    
    ' Get the current date
    currentDate = Date 'Set the date
    'currentDate = dateValue("5/31/2023") 'Set the specific date
    previousMonthDate = DateAdd("m", -1, currentDate) ' Subtract one month
    
    ' Determine the fiscal year
    If previousMonthDate >= fiscalStart Then
        fiscalYear = Year(currentDate)
    Else
        fiscalYear = Year(currentDate) - 1
    End If
    
    ' Output the fiscal year to cell C11
    ThisWorkbook.Sheets(1).Range("C12").Value = fiscalYear
    'MsgBox fiscalYear

End Sub


