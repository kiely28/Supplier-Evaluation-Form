<script>
    document.addEventListener("DOMContentLoaded", function () {

        const serialInput = document.getElementById("basic-default-sno");
        const nameInput = document.getElementById("basic-default-location");

        // 🔍 Detect Serial No validation error
        const serialErrorSpan = document.querySelector(
            "span[data-valmsg-for='SerialNo']"
        );

        const serialErrorText = serialErrorSpan?.innerText.trim();

        const successMessage = "@ViewBag.SuccessMessage";

        // RULE 1: Duplicate Serial No → focus Serial No
        if (serialErrorText === "Serial Number already exists.") {
            serialInput?.focus();
            serialInput?.select();
            return;
        }

        // RULE 2: After successful Save → focus Serial No
        if (successMessage) {
            serialInput?.focus();
            serialInput?.select();
            return;
        }

        // RULE 3: First load → focus Name
        nameInput?.focus();
        nameInput?.select();
    });

    // CLEAR BUTTON
    document.getElementById("btnClear").addEventListener("click", function () {
        document.getElementById("basic-default-sno").value = "";
        document.getElementById("basic-default-name").value = "";
        document.getElementById("basic-default-sno1").value = "";
        document.getElementById("basic-default-category").selectedIndex = 0;
        document.getElementById("basic-default-location").selectedIndex = 0;

        document.getElementById("basic-default-location").focus();
    });
</script>



<script>
    document.getElementById("basic-default-category")
        .addEventListener("change", function () {

            const selected = this.options[this.selectedIndex];
            const uom = selected.getAttribute("data-uom");
            const qtyInput = document.getElementById("quantity");

            if (!uom) {
                qtyInput.value = "";
                qtyInput.disabled = false;
                return;
            }

            if (uom.toLowerCase() === "pc") {
                qtyInput.value = 1;
                qtyInput.disabled = true;
            } else {
                qtyInput.disabled = false;
                if (qtyInput.value === "1") {
                    qtyInput.value = "";
                }
            }
        });
</script>

<script>
    document.getElementById("studentForm").addEventListener("submit", function () {
        document.getElementById("hiddenQuantity").value =
            document.getElementById("quantity").value;
    });
</script>




